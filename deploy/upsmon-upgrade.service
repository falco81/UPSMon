# /etc/systemd/system/upsmon-upgrade.service
#
# Started by upsmon-upgrade.path, never by hand: it puts in the package the
# pages asked for - only one signed by a release key in
# /usr/local/lib/upsmon/release-keys/, and only after checking every file in it.
# It runs apart from upsmon.service, which the upgrade restarts.
[Unit]
Description=upsmon - putting in a new version asked for on the pages
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/upsmon/upsmon_upgrade.py
TimeoutStartSec=25min
PrivateTmp=no
