# /etc/systemd/system/upsmon-web.service
#
# Started by upsmon-web.path, never by hand.
[Unit]
Description=upsmon - the certificate and TLS of nginx, as asked on the pages
After=network-online.target
# Started once per thing asked from the pages, often several in a few seconds:
# systemd's limit of five starts in ten seconds would leave the path unit
# failed and every later ask unanswered.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/upsmon/upsmon_web.py
TimeoutStartSec=30min
